{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SFTPinguin",
  "version": "0.1.0",
  "identifier": "app.sftpinguin.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SFTPinguin",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Modern SFTP, FTP, WebDAV & S3 client",
    "longDescription": "SFTPinguin is a modern, minimalist file transfer client for SFTP, FTP, FTPS, WebDAV and S3.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
